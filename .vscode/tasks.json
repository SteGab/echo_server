{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pytest: Run all tests",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "pytest",
        "-v"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": [
        "$pytest"
      ]
    },
    {
      "label": "pytest: Run with coverage",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "pytest",
        "--cov=app",
        "-v"
      ],
      "group": {
        "kind": "test"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": [
        "$pytest"
      ]
    },
    {
      "label": "pytest: Run tests and clear cache",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "pytest",
        "--cache-clear",
        "-v"
      ],
      "group": {
        "kind": "test"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": [
        "$pytest"
      ]
    },
    {
      "label": "docker: Build image",
      "type": "shell",
      "command": "docker",
      "args": [
        "build",
        "-t",
        "echo-server:latest",
        "."
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "docker: Docker Compose up",
      "type": "shell",
      "command": "docker-compose",
      "args": [
        "up",
        "-d"
      ],
      "group": {
        "kind": "build"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "docker: Docker Compose down",
      "type": "shell",
      "command": "docker-compose",
      "args": [
        "down"
      ],
      "group": {
        "kind": "build"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "podman: Build image",
      "type": "shell",
      "command": "podman",
      "args": [
        "build",
        "-t",
        "echo-server:latest",
        "."
      ],
      "group": {
        "kind": "build"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "podman: Compose up",
      "type": "shell",
      "command": "podman compose",
      "args": [
        "up",
        "-d"
      ],
      "group": {
        "kind": "build"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "podman: Compose down",
      "type": "shell",
      "command": "podman compose",
      "args": [
        "down"
      ],
      "group": {
        "kind": "build"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
  ]
}
