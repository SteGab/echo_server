{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pytest: Run all tests",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "pytest",
        "-v"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": [
        "$pytest"
      ]
    },
    {
      "label": "pytest: Run with coverage",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "pytest",
        "--cov=app",
        "-v"
      ],
      "group": {
        "kind": "test"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": [
        "$pytest"
      ]
    },
    {
      "label": "pytest: Run tests and clear cache",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "pytest",
        "--cache-clear",
        "-v"
      ],
      "group": {
        "kind": "test"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": [
        "$pytest"
      ]
    }
  ]
}
